{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xyzlcu:identity-error:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ok",
    "code",
    "exit_code",
    "nonce",
    "phase",
    "dispatch_state",
    "side_effects_possible",
    "retryable",
    "mismatch_fields",
    "message",
    "mac"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "ok": {
      "const": false
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]+$"
    },
    "exit_code": {
      "type": "integer",
      "minimum": 1,
      "maximum": 255
    },
    "nonce": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 43
    },
    "phase": {
      "enum": [
        "parse",
        "negotiate",
        "precheck",
        "operation",
        "postcheck",
        "release"
      ]
    },
    "dispatch_state": {
      "enum": [
        "not_dispatched",
        "dispatched",
        "unknown"
      ]
    },
    "side_effects_possible": {
      "type": "boolean"
    },
    "retryable": {
      "const": false
    },
    "mismatch_fields": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 128
      }
    },
    "message": {
      "type": "string",
      "maxLength": 256
    },
    "mac": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "key_id",
            "tag"
          ],
          "properties": {
            "algorithm": {
              "const": "hmac-sha256"
            },
            "key_id": {
              "type": "string",
              "maxLength": 128
            },
            "tag": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
    }
  }
}
